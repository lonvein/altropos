PROFILE=3060ti
DATA_DIR=C:/altropos-data
REVIEW_DIR=C:/altropos-private-review
ML_URL=http://127.0.0.1:8081
LLM_URL=http://127.0.0.1:8082/v1
ML_ENABLED=true
LLM_ENABLED=true
LLM_MODEL=Qwen3-8B-GGUF-Q4_K_M
# Replace with actual audited model revision. Startup intentionally fails until set.
LLM_REVISION=UNVERIFIED
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
ML_DEVICE=cpu
PUBLIC_ORIGIN=https://aitropos.ru
UI_SYNTHETIC_FALLBACK=false
REQUEST_TIMEOUT=60
PUBLIC_ASK_DEADLINE=105
LLM_CONCURRENCY=1
# Set after preparing and checking a portable OCR directory:
# TESSERACT_CMD=C:/Altropos/ocr/tesseract.exe
# TESSDATA_PREFIX=C:/Altropos/ocr/tessdata

# --- Web login (the VPS proxy no longer asks for a password) ---------------
# The public demo account admin / qwerty is filled in on the login page and opens every
# function except OCR review and approval. Switch it off with DEMO_LOGIN_ENABLED=false.
AUTH_REQUIRED=true
DEMO_LOGIN_ENABLED=true
MAX_UPLOAD_MB=40
# Separate secret administrator (review and approval of doubtful OCR). Generate with:
#   python scripts/deploy/make_admin_hash.py --user <login>
# Without these two lines nobody can obtain the administrator role through the web.
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
# Optional; generated and stored next to DATA_DIR when empty. At least 32 characters.
# SESSION_SECRET=
