# Reserve GPU profile: RTX 3060 Ti 8 GB, Qwen3-8B Q4_K_M, 4K context,
# BGE on CPU. Fitting 8B in 8 GB VRAM is unverified; scripts/start.sh will
# report the actual health, and the fallback is config/profiles/4b.env.
PROFILE=3060ti
LLM_ENABLED=true
ML_ENABLED=true
ML_DEVICE=cpu
LLM_MODEL=Qwen3-8B-GGUF-Q4_K_M
LLM_REVISION=7c41481f57cb95916b40956ab2f0b139b296d974
LLM_GGUF_FILE=Qwen3-8B-Q4_K_M.gguf
CONTEXT_SIZE=4096
CONTEXT_BUDGET=2200
MAX_OUTPUT_TOKENS=768
TOP_FRAGMENTS=4
LLM_N_GPU_LAYERS=99
LLM_EXTRA_ARGS=--reasoning-budget 0
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b5350@sha256:2fb552ce5860b0e61529bc77a15ecbf40b2169abbda130d4257fadea05037ac4
TORCH_INDEX=https://download.pytorch.org/whl/cpu
THINKING_ENABLED=false
LLM_CONCURRENCY=1
