# Copy to .env and edit only what is needed:
#   cp .env.example .env
# No secrets belong in this file or in Git. If a Hugging Face token is needed,
# export HF_TOKEN in the shell for scripts/download-models.sh only.
#
# Profile selects model, device and context budgets. The supported values are
# development | a100 | 3060ti | 4b. scripts/start.sh also loads the matching
# config/profiles/<name>.env; values there are the deployment source of truth.
PROFILE=development

# --- Application -----------------------------------------------------------
DATA_DIR=runtime
APP_BIND=127.0.0.1
APP_PORT=8000
# Name of the persistent Docker volume for SQLite, originals, extracted files
# and indexes. Do not point this at a directory inside the repository.
RUNTIME_VOLUME=altropos_runtime

# --- Local services (inside Compose; host defaults are for manual runs) -----
LLM_ENABLED=false
ML_ENABLED=false
ML_URL=http://127.0.0.1:8081
LLM_URL=http://127.0.0.1:8082/v1

# --- Models and revisions --------------------------------------------------
# The deployment lock with checksums is config/models.lock.json.
LLM_MODEL=Qwen3-4B-GGUF-Q4_K_M
LLM_REVISION=bc640142c66e1fdd12af0bd68f40445458f3869b
LLM_GGUF_FILE=Qwen3-4B-Q4_K_M.gguf
LLM_N_GPU_LAYERS=0
# Qwen3 runs without thinking mode; the client also sends enable_thinking=false.
LLM_EXTRA_ARGS=--reasoning-budget 0
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b5350@sha256:8a0a31d0b342f96b2c5453eedadbb0544d6d426bd43c9ea6f62b2bd2489be676
# CPU torch index by default; the A100 override uses the CUDA index.
TORCH_INDEX=https://download.pytorch.org/whl/cpu
MODELS_VOLUME=altropos_models

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSION=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

# Profile values below are shown for the 4B reserve. The other profiles set
# their own values in config/profiles/*.env.
# ML_DEVICE=cpu
THINKING_ENABLED=false
LLM_CONCURRENCY=1
# CONTEXT_SIZE=4096
# CONTEXT_BUDGET=2200
# MAX_OUTPUT_TOKENS=768
# TOP_FRAGMENTS=4
PROMPT_RESERVE_TOKENS=1024
REQUEST_TIMEOUT=90
MAX_UPLOAD_MB=40
JOB_TIMEOUT=300
RERANK_THRESHOLD=0.0
THRESHOLD_CALIBRATED=false
# Web UI integration. Router modules are imported by navigator/main.py.
# ASK_ROUTER_MODULE=navigator.rag.router
# DOCUMENTS_ROUTER_MODULE=navigator.documents.router
# Synthetic API fallback is allowed by default only for PROFILE=development.
# Empty means "use the profile default"; set true or false to override.
# Never present synthetic answers as real ones.
# UI_SYNTHETIC_FALLBACK=
