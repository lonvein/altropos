# Safe offline defaults. Copy to .env; configure local model services explicitly.
PROFILE=development
DATA_DIR=runtime
LLM_ENABLED=false
ML_ENABLED=false
ML_URL=http://127.0.0.1:8081
LLM_URL=http://127.0.0.1:8082/v1
# Profile selects model, device and budgets; omit overrides unless intentional.
# PROFILE=a100 | 3060ti | 4b
# LLM_MODEL=Qwen3-4B-GGUF-Q4_K_M
LLM_REVISION=UNVERIFIED
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSION=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=UNVERIFIED
# ML_DEVICE=cpu
THINKING_ENABLED=false
LLM_CONCURRENCY=1
# CONTEXT_SIZE=4096
# CONTEXT_BUDGET=2200
# MAX_OUTPUT_TOKENS=768
# TOP_FRAGMENTS=4
PROMPT_RESERVE_TOKENS=1024
REQUEST_TIMEOUT=90
MAX_UPLOAD_MB=40
JOB_TIMEOUT=300
RERANK_THRESHOLD=0.0
THRESHOLD_CALIBRATED=false
